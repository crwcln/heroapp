#!/bin/sh
# Prefix normal commit subjects with the version configured in js/00-site-config.js.
set -eu

message_file=${1:?Git did not provide a commit message file}
source=${2-}

# Leave merge, squash, and amend messages untouched.
case "$source" in
  merge|squash|commit) exit 0 ;;
esac

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
config_file="$repo_root/js/00-site-config.js"
[ -f "$config_file" ] || exit 0

version=$(sed -n "s/^[[:space:]]*version:[[:space:]]*'\\([^']*\\)'.*/\\1/p" "$config_file" | head -n 1)
[ -n "$version" ] || exit 0
prefix="v$version"
temp_file="${message_file}.version-hook.$$"

awk -v prefix="$prefix" '
  BEGIN { updated = 0 }
  !updated && NF && $0 !~ /^#/ {
    if ($0 == prefix || index($0, prefix ": ") == 1) print $0
    else print prefix ": " $0
    updated = 1
    next
  }
  { print }
  END { if (!updated) print prefix }
' "$message_file" > "$temp_file"

mv "$temp_file" "$message_file"
